#!/usr/bin/env bash
# Local secret scan before every commit. Enable with: git config core.hooksPath .githooks
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --no-banner --redact || {
    echo "gitleaks found a possible secret in the staged changes. Commit refused."; exit 1; }
else
  echo "pre-commit: gitleaks is not installed (brew install gitleaks); CI will still scan."
fi
